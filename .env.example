# Local session signing. Use a long random string before any shared deployment.
AUTH_SECRET=

# Public site URL used for canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:2700

# Optional. Leave blank to run the local beta. Do not put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
